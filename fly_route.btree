/* Strategic command: Traverses active plotted route.
 *
 * Succeeds when route markers are empty and the ship is at its final destination / docked.
 */

-> fly_route {
    @repeat_until_success -> {
        @fail_is_success -> {
            @! phase_is?("docking")
            @! phase_is?("undocking")
            ? {
                @if(push_button_yes) push_message_boxes
                on_space
                on_station
            }
        }
        /* Exit condition: route cleared and dock/arrival confirmed */
        -> {
            ? {
                @! is_state?("dock")
                in_station?()
            }
            @! is_route_set?()
        }
    }
}

-> push_message_boxes {
    is_message_boxes?()
    push_message_boxes()
}

-> on_station {
    phase_is?("docked")
    is_route_set?()
    push_undock_button()
}

-> on_space {
    @! phase_is?("docked")
    ? {
        /* Clear external/stale maneuvers prior to navigation */
        stop_standing_order()
        move
        @if(stealth) stealth
        /* Execute ship module survey in warp if enabled */
        survey_ship(survey_ship, remember_module_names)
    }
}

-> move {
    phase_is?("adrift", "session")
    ? {
        @if(bookmark_jump) dock_bookmark
        @if(bookmark_jump) undock_bookmark
        open_route_menu_and_warp()
    }
}

-> stealth {
    @! is_stealth?()
    phase_is?("warping")
    stealth()
}

-> dock_bookmark {
    is_state?("warp")
    is_last_system?()
    open_dock_bookmarks_menu_and_warp()
}

-> undock_bookmark {
    is_state?("undock")
    open_undock_bookmarks_menu_and_warp()
}
