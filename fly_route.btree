/* Strategic command: fly the route that is already set.
 *
 * Succeeds when the ship is docked and no route remains — that is what "the
 * route has been flown" looks like from the outside. Everything else is
 * Running: the tree keeps ticking and the ship keeps moving.
 *
 * Idempotent by construction: with no route set the exit condition holds on
 * the first tick and the command is done without touching anything. */

-> fly_route {
    @repeat_until_success -> {
        @fail_is_success -> {
            @! is_docking?()
            @! is_undocking?()
            ? {
                @if(push_button_yes) push_message_boxes
                on_space
                on_station
            }
        }
        /* exit condition */
        -> {
            in_station?()
            @! is_route_set?()
        }
    }
}
-> push_message_boxes {
    is_message_boxes?()
    push_message_boxes()
}
/* Undocking is pressed only from a hangar the client is showing. The three
   guards this replaces — no session change, in a station, and three seconds
   since the last press — were all trying to say that, and the timer was there
   because "in a station" stayed true for a moment after the press. The phase
   goes to undocking the instant the client announces it. */
-> on_station {
    phase_is?("docked")
    is_route_set?()
    push_undock_button()
}
-> on_space {
    @! phase_is?("docked")
    ? {
        move
        @if(stealth) stealth
    }
}
/* One phase says all of it: in space, nothing announced, no manoeuvre under
   way — the ship is free and an order given now will be taken. The five
   guards this replaces could each say what was not happening; none could say
   the client was ready, so between them sat a three-second timer guessing. */
-> move {
    /* session is here on trial: the client is said to refuse context menus
       while it changes, and the wait costs nine seconds after every jump.
       The action probes once per session change and reports what happened;
       if the claim holds, this word comes back out. */
    phase_is?("adrift", "session")
    ? {
        @if(bookmark_jump) dock_bookmark
        @if(bookmark_jump) undock_bookmark
        open_route_menu_and_warp()
    }
}
/* The wait that stood here as a condition has moved into the action, where
   every other press in this bot is spaced. The wait itself stays — it guards
   a toggle rather than an order, and F1 pressed twice uncloaks the ship it
   just cloaked — but the tree is no place for it: the tree asks what is true,
   and how long a press is given to land is the action's business. With it
   goes the last timer told in whole seconds off the wall clock.

   What is left is what a tree is for: not cloaked already, and in warp. */
-> stealth {
    @! is_stealth?()
    phase_is?("warping")
    stealth()
}
-> dock_bookmark {
    is_state?("warp")
    is_last_system?()
    open_dock_bookmarks_menu_and_warp()
}
-> undock_bookmark {
    is_state?("undock")
    open_undock_bookmarks_menu_and_warp()
}
