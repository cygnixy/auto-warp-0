/* The mission: set a route, fly it, and — if a return destination is given —
 * turn around and fly it back.
 *
 * destination — the name to search for. Empty means "the route is already
 * set, just fly it", which is exactly what this bot did before it could set
 * routes, so an operator who upgrades and changes nothing gets the old
 * behaviour.
 *
 * destination_kind — which category of the search results the name is looked
 * up in: "system" for a solar system, "station" for a station. The route ends
 * where it is told to end, and flying is the same either way: fly_route picks
 * "Dock" from the route marker's menu just as readily as "Jump Through
 * Stargate".
 *
 * return_destination, return_kind — the same two questions for the way home.
 * An empty return_destination is a one-way mission: it flies out and stops
 * there, which is the behaviour above unchanged. A return_destination given
 * closes the mission instead: once the outward leg is flown, legs_done turns
 * the ship around and set_route is asked for the return place instead of the
 * outward one.
 *
 * There is no second set_route or fly_route below: neurofolia's named
 * subtrees are shared nodes rather than copies (graph.rs:51 adds an edge to
 * the same index however many times the name is written), so a tree cannot
 * fly to two different places by referencing set_route twice. Instead there
 * is one leg at a time, held on the blackboard by leg.lua, and the pair of
 * commands runs once per leg inside a repeat: the outward leg first, and —
 * only if legs_done flips it — the return leg on the next pass. */

destination = ""
destination_kind = "system"
return_destination = ""
return_kind = "station"

stealth = false
bookmark_jump = false
push_button_yes = false

include('set_route.btree')
include('fly_route.btree')

/* journal writes the mission's account of itself and presses nothing. It sits
 * in a plain sequence ahead of the commands so that it runs on every tick of
 * both: inside the memory sequence below it would run once, be remembered as
 * done, and the flight — the part worth reading back — would go unrecorded.
 * It always succeeds, so the commands are reached whatever it sees. */
-> main {
    journal(destination, destination_kind, return_destination)

    /* A modal blocks the whole client, so it goes first and the rest of the
       tick waits behind it. Only the acknowledging kind is pressed here -- OK
       and Close, never Yes. */
    dismiss_message_box()

    /* The outer ->* is memory: once the whole mission — both legs, if there
       are two — is done, it stays done, and a mission restarted mid-flight
       does not repeat legs it already flew.
       The inner repeat_until_success is the loop the turn lives in: each
       pass sets the route for the current leg and flies it in a fresh
       memory sequence, then asks legs_done whether another leg remains.
       legs_done succeeding ends the mission (Success bubbles out of the
       repeat and the outer ->* forgets nothing further needs doing). legs_done
       failing — the turn — fails the sequence it sits in, which is exactly
       what @repeat_until_success is watching for: it runs the sequence again,
       and because ->* forgets its own progress on completion (not on
       failure of what follows it), the inner ->* starts the route from
       scratch. By then leg.lua's _leg already says "home", so set_route and
       fly_route are asked for the return place.

       Timeline of the turn: on the tick the outward leg's ->* completes with
       Success, legs_done runs in the same tick, flips _leg to "home", and
       returns Failure — the sequence around it fails, the repeat stays
       Running. On the next tick the inner ->* re-enters from its first step,
       and by then _leg already reads "home", so every set_route action asks
       for the return destination instead of the outward one. */
    ->* {
        @repeat_until_success -> {
            ->* {
                set_route
                fly_route
            }
            legs_done?(return_destination)
        }
    }
}
