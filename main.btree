/* Auto-warp-0 Bot: Autonomous travel navigation and stargate autopilot.
 *
 * Coordinates route traversal, destination searching, in-flight fitting survey,
 * travel Overview tab maintenance, and standing order clearance.
 */

destination = ""
destination_kind = "system"
return_destination = ""
return_kind = "station"

stealth = false
bookmark_jump = false
push_button_yes = false
travel_tab = 0
survey_ship = false
remember_module_names = false
weapon_modules = ""
downtime_guard_seconds = 300

include('set_route.btree')
include('fly_route.btree')

-> main {
    /* Abort if cluster downtime is imminent */
    downtime_guard(downtime_guard_seconds)

    /* Record destination and execution details */
    journal(destination, destination_kind, return_destination)

    /* Monitor overall flight progress to prevent infinite stalls */
    flight_progress()

    /* Verify flight destination is valid/meaningful */
    somewhere_to_fly(destination, return_destination, destination_kind)

    /* Clear blocking message boxes if present */
    dismiss_message_box()

    /* Ensure Overview is on travel tab for flight safety */
    select_travel_tab(travel_tab)

    /* Verify and report ship HUD health readability */
    report_ship_health()

    /* Top up weapon magazines while a warp leg lasts */
    reload_weapons(weapon_modules)

    /* Execute route flight or finalize immediately if already at destination */
    ? {
        /* Destination reached: execute static fitting survey if required */
        -> {
            flight_is_over?(destination, return_destination)
            survey_without_flying(survey_ship, remember_module_names)
        }

        /* Flight traversal loop across legs */
        ->* {
            @repeat_until_success -> {
                ->* {
                    set_route
                    fly_route
                }
                legs_done?(return_destination)
            }
        }
    }
}
