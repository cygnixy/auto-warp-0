/* The mission: set a route, then fly it.
 *
 * Two strategic commands in a memory sequence, which is what makes this a
 * mission rather than one big tree: a finished step is not restarted on the
 * next tick, so once the route is set the bot stops touching the search and
 * gets on with flying.
 *
 * destination — the name to search for. Empty means "the route is already
 * set, just fly it", which is exactly what this bot did before it could set
 * routes, so an operator who upgrades and changes nothing gets the old
 * behaviour.
 *
 * destination_kind — which category of the search results the name is looked
 * up in: "system" for a solar system, "station" for a station. The route ends
 * where it is told to end, and flying is the same either way: fly_route picks
 * "Dock" from the route marker's menu just as readily as "Jump Through
 * Stargate". */

destination = ""
destination_kind = "system"

stealth = false
bookmark_jump = false
push_button_yes = false

include('set_route.btree')
include('fly_route.btree')

->* main {
    set_route
    fly_route
}
